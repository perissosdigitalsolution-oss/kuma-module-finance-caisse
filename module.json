{
  "id": "kuma-module-finance-caisse",
  "name": "KUMA Module — Petite Caisse & Reçus (Côte d'Ivoire) v1.0.0",
  "version": "1.0.0",
  "apiVersion": "v1",
  "country": "CI",
  "countryLabel": "Côte d'Ivoire",
  "description": "Gestion de la petite caisse avec encaissements, générations de reçus PDF, et suivi des paiements échelonnés. Module autonome bridge.",
  "mountPath": "/api/v1/modules/finance",
  "entry": {
    "server": "server/financeModule.ts",
    "standalone": "server/standalone/index.ts",
    "frontend": "frontend/CaisseManager.tsx",
    "schema": "server/schema.sql"
  },
  "requires": {
    "hono": ">=4.0.0",
    "d1Binding": "DB",
    "authContextVars": [
      "tenantId",
      "jwtPayload"
    ]
  },
  "permissions": {
    "admin": [
      "read",
      "write",
      "import",
      "delete",
      "print-receipt"
    ],
    "accountant": [
      "read",
      "write"
    ],
    "teacher": [
      "read"
    ],
    "parent": [
      "read_own",
      "request-receipt"
    ]
  },
  "capabilities": {
    "hasBridgeMode": true,
    "supportsReçusPdf": true,
    "supportsÉchelonnement": true,
    "supportsImpressionThermique": true,
    "standaloneSupported": true
  },
  "author": "perissosdigitalsolution-oss",
  "license": "MIT",
  "repository": "https://github.com/perissosdigitalsolution-oss/kuma-module-finance-caisse"
}